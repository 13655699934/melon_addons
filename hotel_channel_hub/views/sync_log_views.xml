<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- 同步日志列表视图 -->
        <record id="view_sync_log_list" model="ir.ui.view">
            <field name="name">hotel.sync.log.list</field>
            <field name="model">hotel.sync.log</field>
            <field name="arch" type="xml">
                <list string="同步日志" decoration-success="status == 'success'"
                      decoration-danger="status == 'failed'"
                      decoration-warning="status == 'pending'"
                      default_order="create_date desc">
                    <field name="create_date"/>
                    <field name="channel_id"/>
                    <field name="operation"/>
                    <field name="order_id"/>
                    <field name="status" widget="badge" 
                           decoration-success="status == 'success'"
                           decoration-danger="status == 'failed'"
                           decoration-warning="status == 'pending'"/>
                    <field name="message"/>
                    <field name="duration"/>
                    <field name="ip_address"/>
                </list>
            </field>
        </record>

        <!-- 同步日志表单视图 -->
        <record id="view_sync_log_form" model="ir.ui.view">
            <field name="name">hotel.sync.log.form</field>
            <field name="model">hotel.sync.log</field>
            <field name="arch" type="xml">
                <form string="同步日志" create="0" edit="0">
                    <header>
                        <button name="action_view_order" type="object" string="查看订单" 
                                invisible="not order_id"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="create_date" readonly="1"/>
                                <field name="channel_id" readonly="1"/>
                                <field name="operation" readonly="1"/>
                                <field name="order_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="status" readonly="1"/>
                                <field name="duration" readonly="1"/>
                                <field name="ip_address" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="消息">
                                <group>
                                    <field name="message" nolabel="1" readonly="1"/>
                                </group>
                            </page>
                            <page string="错误信息" invisible="not error_message">
                                <group>
                                    <field name="error_message" nolabel="1" readonly="1" 
                                           widget="text" style="color: red;"/>
                                </group>
                            </page>
                            <page string="请求数据" invisible="not request_data">
                                <field name="request_data" nolabel="1" readonly="1" widget="ace"/>
                            </page>
                            <page string="响应数据" invisible="not response_data">
                                <field name="response_data" nolabel="1" readonly="1" widget="ace"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 同步日志搜索视图 -->
        <record id="view_sync_log_search" model="ir.ui.view">
            <field name="name">hotel.sync.log.search</field>
            <field name="model">hotel.sync.log</field>
            <field name="arch" type="xml">
                <search string="搜索日志">
                    <field name="channel_id"/>
                    <field name="operation"/>
                    <field name="order_id"/>
                    <separator/>
                    <filter string="成功" name="filter_success" domain="[('status', '=', 'success')]"/>
                    <filter string="失败" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                    <filter string="处理中" name="filter_pending" domain="[('status', '=', 'pending')]"/>
                    <separator/>
                    <filter string="今天" name="filter_today" 
                            domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="最近7天" name="filter_week" 
                            domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="分组">
                        <filter string="渠道" name="group_channel" context="{'group_by': 'channel_id'}"/>
                        <filter string="操作类型" name="group_operation" context="{'group_by': 'operation'}"/>
                        <filter string="状态" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="创建日期" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- 同步日志动作 -->
        <record id="action_hotel_sync_log" model="ir.actions.act_window">
            <field name="name">同步日志</field>
            <field name="res_model">hotel.sync.log</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_week': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    暂无日志记录
                </p>
                <p>
                    系统会自动记录所有API调用和操作日志
                </p>
            </field>
        </record>

    </data>
</odoo>

