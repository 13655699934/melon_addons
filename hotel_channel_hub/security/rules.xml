<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- 酒店记录规则 - 多公司 -->
        <record id="hotel_hotel_comp_rule" model="ir.rule">
            <field name="name">酒店多公司规则</field>
            <field name="model_id" ref="model_hotel_hotel"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 房型记录规则 - 多公司 -->
        <record id="hotel_room_type_comp_rule" model="ir.rule">
            <field name="name">房型多公司规则</field>
            <field name="model_id" ref="model_hotel_room_type"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 房间记录规则 - 多公司 -->
        <record id="hotel_room_comp_rule" model="ir.rule">
            <field name="name">房间多公司规则</field>
            <field name="model_id" ref="model_hotel_room"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 渠道记录规则 - 多公司 -->
        <record id="hotel_channel_comp_rule" model="ir.rule">
            <field name="name">渠道多公司规则</field>
            <field name="model_id" ref="model_hotel_channel"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 订单记录规则 - 多公司 -->
        <record id="hotel_order_comp_rule" model="ir.rule">
            <field name="name">订单多公司规则</field>
            <field name="model_id" ref="model_hotel_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 库存记录规则 - 多公司 -->
        <record id="hotel_room_availability_comp_rule" model="ir.rule">
            <field name="name">库存多公司规则</field>
            <field name="model_id" ref="model_hotel_room_availability"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 前台用户只能看到自己负责的酒店数据（可选配置） -->
        <!-- 这里假设用户有一个字段关联到酒店，需要根据实际情况调整 -->
        
    </data>
</odoo>

