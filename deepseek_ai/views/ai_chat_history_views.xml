<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <!-- list View -->
    <record id="view_ai_chat_history_list" model="ir.ui.view">
        <field name="name">ai.chat.history.list</field>
        <field name="model">ai.chat.history</field>
        <field name="arch" type="xml">
            <list string="AI Chat Histories" create="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="model_name"/>
                <field name="message" widget="text"/>
                <field name="ai_response" widget="html"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ai_chat_history_form" model="ir.ui.view">
        <field name="name">ai.chat.history.form</field>
        <field name="model">ai.chat.history</field>
        <field name="arch" type="xml">
            <form string="AI Chat History" create="false" >
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="message" readonly="1"/>
                        <field name="ai_response" widget="html" readonly="1"/>
                    </group>
                    <group>
                        <field name="annex_file" filename="annex_filename" readonly="1"/>
                        <field name="annex_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_ai_chat_history_action" model="ir.actions.act_window">
        <field name="name">AI 聊天记录</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ai.chat.history</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
